<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

     <!-- Content Page style -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="NavigationPage.HasNavigationBar" Value="False"/>
        <Setter Property="Background" Value="{StaticResource PageBackroundColor}"/>
    </Style>

    <!--Grid style-->
    <Style TargetType="Grid">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="RowSpacing" Value="0"/>
        <Setter Property="ColumnSpacing" Value="0"/>
        <Setter Property="VerticalOptions" Value="Fill"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
    </Style>

    <!--Button styles-->
    <!--Number Button style-->
    <Style TargetType="Button" x:Key="NumberButtonStyle">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontFamily" Value="ReguralFont"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="BackgroundColor" Value="#202731"/>
        <Setter Property="BorderWdith" Value="0"/>
        <Setter Property="BorderColor" Value="{StaticResource BorderColor}"/>
        <Setter Property="VerticalOptions" Value="Fill"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="CornerOptions" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,1,1"/>
        <Setter Property="FontAutoScaling" Value="False"/>
    </Style>

    <!--Operator Buttob style-->
    <Style TargetType="Button" x:Key="OperatorButtobStyle">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontFamily" Value="ReguralFont"/>
        <Setter Property="TextColor" Value="Black"/>
        <Setter Property="BackgroundColor" Value="#efbb31"/>
        <Setter Property="BorderWdith" Value="0"/>
        <Setter Property="BorderColor" Value="{StaticResource BorderColor}"/>
        <Setter Property="VerticalOptions" Value="Fill"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="CornerOptions" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,1,1"/>
        <Setter Property="FontAutoScaling" Value="False"/>
    </Style>

    <!--Scientific Operator Button style-->
    <Style TargetType="Button" x:Key="ScientificOperatorButtonStyle">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="ReguralFont"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="BackgroundColor" Value="#2c3240"/>
        <Setter Property="BorderWdith" Value="1"/>
        <Setter Property="BorderColor" Value="{StaticResource BorderColor}"/>
        <Setter Property="VerticalOptions" Value="Fill"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="CornerOptions" Value="6"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="6,6"/>
        <Setter Property="Shadow">
            <Shadow
                Brush="Black"
                Offset="6,6"
                Radius="12"
                Opacity="0.5"/>
        </Setter>
        <Setter Property="FontAutoScalingEnabled" Value="False"/>
    </Style>
    
    <!--label styles-->
    <!--Eqals Label styles-->
    <Style TargetType="Label" x:Key="EqualsLabel">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="TextColor" Value="#efbb31"/>
        <Setter Property="FontFamily" Value="LightFont"/>
        <Setter Property="LineBreakMode" Value="TailTruncation"/>
        <Setter Property="FontAutoScalingEnabled" Value="False"/>
    </Style>

    <!--Result Label styles-->
    <Style TargetType="Label" x:Key="ResultLabel">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontFamily" Value="ReguralFont"/>
        <Setter Property="LineBreakMode" Value="TailTruncation"/>
        <Setter Property="FontAutoScalingEnabled" Value="False"/>
    </Style>

    <!--Input Box Label style-->
    <Style TargetType="Label" x:Key="InputBoxLabelStyle">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontFamily" Value="LightFont"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
        <Setter Property="FontAutoScalingEnabled" Value="False"/>
    </Style>

</ResourceDictionary>
